# Release automation for the official App Store build.
#
# Lanes:
#   fastlane setup_signing   (run ONCE on a maintainer's Mac) creates the
#                            distribution certificate + App Store profile and
#                            stores them encrypted in the match repo.
#   fastlane release         (run by .github/workflows/release.yml) builds a
#                            signed archive and uploads it to TestFlight.
#
# Required environment variables — see RELEASING.md:
#   ASC_KEY_ID, ASC_ISSUER_ID, ASC_KEY_P8_BASE64   App Store Connect API key
#   MATCH_GIT_URL, MATCH_PASSWORD                  encrypted signing repo
#   MATCH_GIT_PRIVATE_KEY                          (CI only) read-only deploy key

default_platform(:ios)

APP_ID   = "com.world360.flysightexplorer"
PROJECT  = "FlysightExplorer_ios.xcodeproj"
SCHEME   = "FlysightExplorer_ios"
PROFILE  = "match AppStore #{APP_ID}"

platform :ios do
  def asc_api_key
    app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_content: ENV.fetch("ASC_KEY_P8_BASE64"),
      is_key_content_base64: true,
      in_house: false
    )
  end

  desc "One-time: create/refresh App Store signing assets in the match repo"
  lane :setup_signing do
    match(type: "appstore", readonly: false, api_key: asc_api_key)
  end

  desc "Build a signed release and upload it to TestFlight"
  lane :release do
    setup_ci # temporary keychain on CI; no-op locally
    api_key = asc_api_key

    match_opts = { type: "appstore", readonly: true, api_key: api_key }
    if ENV["MATCH_GIT_PRIVATE_KEY"].to_s != ""
      key_path = File.join(Dir.tmpdir, "match_deploy_key")
      File.write(key_path, ENV["MATCH_GIT_PRIVATE_KEY"].strip + "\n")
      File.chmod(0o600, key_path)
      match_opts[:git_private_key] = key_path
    end
    match(**match_opts)

    # Version comes from the tag (v1.2.3 -> 1.2.3); build number is always
    # one higher than the latest build on TestFlight for that version.
    version = ENV["RELEASE_VERSION"].to_s.sub(/\Av/, "")
    UI.user_error!("RELEASE_VERSION (e.g. v1.2.3) is required") unless version.match?(/\A\d+(\.\d+){1,2}\z/)
    build = latest_testflight_build_number(
      api_key: api_key, app_identifier: APP_ID, version: version, initial_build_number: 0
    ) + 1

    build_app(
      project: PROJECT,
      scheme: SCHEME,
      configuration: "Release",
      export_method: "app-store",
      clean: true,
      output_directory: "build",
      xcargs: [
        "MARKETING_VERSION=#{version}",
        "CURRENT_PROJECT_VERSION=#{build}",
        "CODE_SIGN_STYLE=Manual",
        "CODE_SIGN_IDENTITY='Apple Distribution'",
        "PROVISIONING_PROFILE_SPECIFIER='#{PROFILE}'"
      ].join(" "),
      export_options: { provisioningProfiles: { APP_ID => PROFILE } }
    )

    # With a changelog, fastlane waits until the build shows up in App Store
    # Connect, sets "What to Test", and then stops waiting.
    upload_to_testflight(
      api_key: api_key,
      changelog: testflight_notes(version),
      skip_waiting_for_build_processing: true
    )
  end

  # Plain-text "What to Test" for TestFlight: one line per commit (squash-merged
  # PR titles) since the previous v* tag, without dependency bumps.
  def testflight_notes(version)
    prev = begin
      sh("git", "describe", "--tags", "--abbrev=0", "--match", "v*", "HEAD^", log: false).strip
    rescue StandardError
      ""
    end
    range = prev.empty? ? "HEAD" : "#{prev}..HEAD"
    subjects = sh("git", "log", "--no-merges", "--pretty=format:%s", range, log: false)
               .lines.map(&:strip)
               .reject { |s| s.empty? || s.match?(/\A(Bump |build\(deps)/i) }
               .map { |s| "• " + s.sub(/\s*\(#\d+\)\z/, "") }
    header = prev.empty? ? "Version #{version}" : "Version #{version} — changes since #{prev}:"
    notes = ([header] + subjects).join("\n")
    notes.length > 3900 ? notes[0, 3900] + "\n…" : notes
  end
end
